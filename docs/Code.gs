/** AlóPío AI: backend DEMO vinculado a una hoja privada. */
const SHEET_ID = '1yh6C3s6V7a8sc-2C_LrWWtVkkcfFCRroWXPNfgjQJQE';
const AGENT_ID = 'agent_1001m645ehe2fjmv4ys682bcbxrw';
const MENU = [{"id": "entero", "name": "Pollo entero", "category": "Pollo", "description": "Pollo al horno, papas y ensalada para compartir.", "priceCents": 9500, "available": true, "image": "assets/pollo.jpg"}, {"id": "medio", "name": "Medio pollo", "category": "Pollo", "description": "Medio pollo con papas y ensalada.", "priceCents": 5200, "available": true, "image": "assets/pollo.jpg"}, {"id": "cuarto", "name": "Cuarto de pollo", "category": "Pollo", "description": "Tu porción de pollo con papas y ensalada.", "priceCents": 2800, "available": true, "image": "assets/pollo.jpg"}, {"id": "papas", "name": "Papas para compartir", "category": "Adicionales", "description": "Porción extra de papas.", "priceCents": 1500, "available": true, "image": "assets/papas.jpg"}, {"id": "ensalada", "name": "Ensalada fresca", "category": "Adicionales", "description": "Una porción para acompañar.", "priceCents": 1000, "available": true, "image": "assets/ensalada.jpg"}, {"id": "gaseosa", "name": "Gaseosa 2 litros", "category": "Bebidas", "description": "Bebida de demostración, sin marca asignada.", "priceCents": 1600, "available": true, "image": null}, {"id": "combo", "name": "Combo de la casa", "category": "Combos", "description": "Un pollo entero, papas, ensalada y gaseosa de 2 litros.", "priceCents": 10900, "available": true, "image": "assets/pollo.jpg"}];
function output(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function secret(){const props=PropertiesService.getScriptProperties();let key=props.getProperty('SESSION_SECRET');if(!key){key=Utilities.getUuid()+Utilities.getUuid();props.setProperty('SESSION_SECRET',key);}return key;}
function signature(value){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(value,secret())).replace(/=+$/,'');}
function sessionToken(){const body=Utilities.base64EncodeWebSafe(JSON.stringify({id:Utilities.getUuid(),expires:Date.now()+86400000})).replace(/=+$/,'');return body+'.'+signature(body);}
function owner(token){if(typeof token!=='string'||token.length>500)throw Error('Sesión requerida');const parts=token.split('.');if(parts.length!==2||signature(parts[0])!==parts[1])throw Error('Sesión inválida');const data=JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString());if(data.expires<Date.now())throw Error('Sesión vencida');return signature('owner:'+data.id);}
function sheet(){const file=SpreadsheetApp.openById(SHEET_ID);let tab=file.getSheetByName('Pedidos');if(!tab)tab=file.insertSheet('Pedidos');if(tab.getLastColumn()<12)tab.getRange(1,1,1,12).setValues([['ID','Fecha','Modo','Canal','Estado','Productos','Total BOB','Cantidades','Categorías','Confirmación','OwnerHash','Idempotencia']]);return tab;}
function orders(){const tab=sheet();if(tab.getLastRow()<2)return [];return tab.getRange(2,1,tab.getLastRow()-1,12).getValues().filter(r=>r[0]).map(r=>({id:String(r[0]),timestamp:String(r[1]),demo:true,channel:String(r[3]),status:String(r[4]),items:JSON.parse(String(r[5])),totalCents:Math.round(Number(r[6])*100),_owner:String(r[10]),_idem:String(r[11])}));}
function publicOrder(o){const copy=Object.assign({},o);delete copy._owner;delete copy._idem;return copy;}
function quoteItems(cart){if(!Array.isArray(cart)||!cart.length||cart.length>30)throw Error('Carrito vacío o excesivo');const merged={};cart.forEach(i=>{if(!i||typeof i.id!=='string'||!Number.isSafeInteger(i.quantity)||i.quantity<1||i.quantity>20)throw Error('Cantidad inválida');merged[i.id]=(merged[i.id]||0)+i.quantity;});const items=Object.keys(merged).map(id=>{const p=MENU.find(p=>p.id===id),quantity=merged[id];if(!p||!p.available||quantity>20)throw Error('Producto no disponible');return {id,name:p.name,category:p.category,quantity,priceCents:p.priceCents,subtotalCents:p.priceCents*quantity};});return {items,totalCents:items.reduce((s,i)=>s+i.subtotalCents,0)};}
function doGet(){return output({ok:true,name:'AlóPío AI',demo:true,message:'Backend DEMO, usar POST para operaciones.'});}
function doPost(event){let lock;try{if(!event.postData||event.postData.contents.length>20000)throw Error('Solicitud inválida');const req=JSON.parse(event.postData.contents),op=req.op,b=req.body||{},cache=CacheService.getScriptCache();if(op==='/config')return output({ok:true,data:{demo:true,agentId:AGENT_ID,sheets:'synced',backend:'apps-script'}});if(op==='/catalog')return output({ok:true,data:MENU});if(op==='/session')return output({ok:true,data:{csrf:sessionToken()}});const who=owner(req.token);let n=Number(cache.get('rate:'+who)||0);if(n>=120)throw Error('Límite temporal, vuelve a intentar en un minuto');cache.put('rate:'+who,String(n+1),60);
 if(op==='/quote'){const q=quoteItems(b.cart);q.id=Utilities.getUuid();cache.put('quote:'+q.id,JSON.stringify({owner:who,quote:q}),600);return output({ok:true,data:q});}
 if(op==='/orders'&&req.method==='GET')return output({ok:true,data:orders().filter(o=>o._owner===who).map(publicOrder)});
 if(op==='/orders'&&req.method==='POST'){if(b.confirmed!==true||typeof b.idempotencyKey!=='string'||! /^[a-zA-Z0-9-]{16,80}$/.test(b.idempotencyKey))throw Error('Confirmación explícita requerida');lock=LockService.getScriptLock();lock.waitLock(15000);const existing=orders().find(o=>o._owner===who&&o._idem===b.idempotencyKey);if(existing)return output({ok:true,data:{order:publicOrder(existing),duplicate:true,sheets:'synced'}});const cached=cache.get('quote:'+b.quoteId);if(!cached)throw Error('Cotización vencida');const stored=JSON.parse(cached);if(stored.owner!==who)throw Error('Cotización de otra sesión');const fresh=quoteItems(stored.quote.items);if(fresh.totalCents!==stored.quote.totalCents)throw Error('El catálogo cambió');const order={id:Utilities.getUuid(),timestamp:new Date().toISOString(),demo:true,channel:b.channel==='assistant'?'assistant':'web',status:'confirmed',items:fresh.items,totalCents:fresh.totalCents};sheet().appendRow([order.id,order.timestamp,'DEMO',order.channel,order.status,JSON.stringify(order.items),order.totalCents/100,order.items.map(i=>i.quantity).join(' / '),order.items.map(i=>i.category).join(' / '),'Explícita',who,b.idempotencyKey]);SpreadsheetApp.flush();cache.remove('quote:'+b.quoteId);return output({ok:true,data:{order,sheets:'synced'}});}
 if(op.startsWith('/admin/'))throw Error('Administración: consulta la hoja privada de Google Sheets. El panel con token requiere el backend Node.');throw Error('Operación desconocida');
 }catch(error){return output({ok:false,error:error.message});}finally{if(lock)lock.releaseLock();}}
